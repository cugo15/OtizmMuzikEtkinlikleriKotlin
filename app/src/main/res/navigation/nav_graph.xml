<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.aecg.oyunvemuzikae.ui.fragment.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/homeFragment_to_pianoFragment"
            app:destination="@id/pianoFragment" />
        <action
            android:id="@+id/homeFragment_to_menuFragment"
            app:destination="@id/menuFragment" />
        <action
            android:id="@+id/homeFragment_to_muzikFragment"
            app:destination="@id/muzikFragment" />
    </fragment>
    <fragment
        android:id="@+id/pianoFragment"
        android:name="com.aecg.oyunvemuzikae.ui.fragment.PianoFragment"
        android:label="fragment_piano"
        tools:layout="@layout/fragment_piano" >
        <action
            android:id="@+id/pianoFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/sesFragment"
        android:name="com.aecg.oyunvemuzikae.ui.fragment.SesFragment"
        android:label="fragment_ses"
        tools:layout="@layout/fragment_ses" >
        <argument
            android:name="sesList"
            app:argType="com.aecg.oyunvemuzikae.Sesler.SesModel[]" />
    </fragment>
    <fragment
        android:id="@+id/menuFragment"
        android:name="com.aecg.oyunvemuzikae.ui.fragment.MenuFragment"
        android:label="fragment_menu"
        tools:layout="@layout/fragment_menu" >
        <action
            android:id="@+id/menuFragment_to_sesFragment"
            app:destination="@id/sesFragment" />
        <argument
            android:name="menuList"
            app:argType="com.aecg.oyunvemuzikae.ui.MenuModel[]" />
        <action
            android:id="@+id/menuFragment_to_oyunHizliYavasFragment"
            app:destination="@id/oyunHizliYavasFragment" />
        <action
            android:id="@+id/menuFragment_to_oyunResimdenSestenBulFragment"
            app:destination="@id/oyunResimdenSestenBulFragment" />
        <action
            android:id="@+id/menuFragment_to_self"
            app:destination="@id/menuFragment" />
        <action
            android:id="@+id/menuFragment_to_oyunHafizaFragment"
            app:destination="@id/oyunHafizaFragment" />
    </fragment>
    <fragment
        android:id="@+id/oyunHizliYavasFragment"
        android:name="com.aecg.oyunvemuzikae.ui.fragment.OyunHizliYavasFragment"
        android:label="fragment_oyun_hizli_yavas"
        tools:layout="@layout/fragment_oyun_hizli_yavas" >
        <argument
            android:name="hizliYavasList"
            app:argType="com.aecg.oyunvemuzikae.Sesler.SesModel[]" />
        <action
            android:id="@+id/action_oyunHizliYavasFragment_self"
            app:destination="@id/oyunHizliYavasFragment"
            app:popUpTo="@id/oyunHizliYavasFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/oyunResimdenSestenBulFragment"
        android:name="com.aecg.oyunvemuzikae.ui.fragment.OyunResimdenSestenBulFragment"
        android:label="fragment_oyun_resimden_sesten_bul"
        tools:layout="@layout/fragment_oyun_resimden_sesten_bul" >
        <argument android:name="resimdenSestenBulList"
            app:argType="com.aecg.oyunvemuzikae.Sesler.SesModel[]" />
        <argument
            android:name="gameType"
            app:argType="com.aecg.oyunvemuzikae.domain.GameType" />
        <action
            android:id="@+id/oyunResimdenSestenBulFragment_self"
            app:destination="@id/oyunResimdenSestenBulFragment"
            app:popUpTo="@id/oyunResimdenSestenBulFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/muzikFragment"
        android:name="com.aecg.oyunvemuzikae.ui.fragment.MuzikFragment"
        android:label="fragment_muzik"
        tools:layout="@layout/fragment_muzik" >
        <argument
            android:name="muzikList"
            app:argType="com.aecg.oyunvemuzikae.ui.MuzikModel[]" />
        <action
            android:id="@+id/action_muzikFragment_to_webViewDialogFragment"
            app:destination="@id/webViewDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/webViewDialogFragment"
        android:name="com.aecg.oyunvemuzikae.ui.fragment.WebViewDialogFragment"
        android:label="YouTube Video">
        <argument
            android:name="videoId"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/oyunHafizaFragment"
        android:name="com.aecg.oyunvemuzikae.ui.fragment.OyunHafizaFragment"
        android:label="fragment_oyun_hafiza"
        tools:layout="@layout/fragment_oyun_hafiza" >
        <argument android:name="enstrumanList"
            app:argType="com.aecg.oyunvemuzikae.Sesler.SesModel[]" />
        <argument
            android:name="difficulty"
            app:argType="integer" />
        <action
            android:id="@+id/action_oyunHafizaFragment_self"
            app:destination="@id/oyunHafizaFragment"
            app:popUpTo="@id/oyunHafizaFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="lvl"
            app:argType="integer" />
    </fragment>
</navigation>